# X (Twitter) search API config
# Copy to .env and fill in. Values are used by src/config.ts

# Your session cookies from x.com (required for authenticated requests)
X_AUTH_TOKEN=your_auth_token
X_CT0=your_ct0_token
X_GUEST_TOKEN=your_guest_id

# Public web-client bearer token (well-known public constant)
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAANRILgAAAAAAnNwIzUejRCOuH5E6I8xnZz4puTs%3D1Zv7ttfk8LF81IUq16cHjhLTvJu4FA33AGWWjCpTnA

# GraphQL operation id for SearchTimeline (resolved from the web client bundle)
X_SEARCH_TIMELINE_QUERY_ID=hyPfJYJ_XAtDYoslQc-Rgg

# HTTP server
PORT=3000