# X (Twitter) search API config
# Copy to .env and fill in. Values are used by src/config.ts

# Your session cookies from x.com (required for authenticated requests)
X_AUTH_TOKEN=your_auth_token
X_CT0=your_ct0_token
X_GUEST_TOKEN=your_guest_id

# Public web-client bearer token (well-known public constant)
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAANRILgAAAAAAnNwIzUejRCOuH5E6I8xnZz4puTs%3D1Zv7ttfk8LF81IUq16cHjhLTvJu4FA33AGWWjCpTnA

# GraphQL operation id for SearchTimeline (resolved from the web client bundle)
X_SEARCH_TIMELINE_QUERY_ID=hyPfJYJ_XAtDYoslQc-Rgg

# HTTP server
PORT=3000

# Apify (optional). APIFY_TOKEN2 is used as a fallback if the first fails.
# APIFY_TOKEN=
# APIFY_TOKEN2=
# APIFY_TOKEN3=

# OpenRouter AI (Proposal Generator)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Proposal generation tuning
PROPOSAL_MAX_TOKENS=6000
PROPOSAL_MAX_RETRIES=3
PROPOSAL_TIMEOUT_MS=60000

# Email & Resume Attachment Configuration
# Preferred: upload the resume in the app (Profile → Resume PDF). It's stored in
# the database, so it works on Vercel with no env var and no redeploy.
# Optional fallbacks (in priority order): DB → RESUME_PDF_BASE64 → RESUME_PATH → ./resume.pdf
# RESUME_PDF_BASE64=            # base64 of the PDF (note: large PDFs may exceed Vercel env limits)
# RESUME_FILENAME=Umer_Waqas_Software_Engineer_Resume.pdf
RESUME_PATH=/Users/themacstore/Downloads/Umer_Waqas_General_Software_Engineer_Resume_2_Page_Vibe_Coding_With_Photo.pdf
# ── Upstream timeouts & rate-limit tuning (milliseconds) ────────────────────
# NOTE: search results are NOT cached — every request returns live data.
X_TIMEOUT_MS=12000
LINKEDIN_TIMEOUT_MS=10000
REDDIT_MIN_INTERVAL_MS=1500
REDDIT_MAX_RETRIES=3
REDDIT_TIMEOUT_MS=15000
APIFY_RUN_TIMEOUT_MS=45000
APIFY_HTTP_TIMEOUT_MS=30000

# ── Database & cookies (Vercel production) ──────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# LINKEDIN_COOKIES=   (Netscape cookie file or Cookie header; DB takes priority)
# REDDIT_COOKIES=
# FACEBOOK_COOKIES=

# ── Google Sign-In (Firebase, client-side) ──────────────────────────────────
# The web config is public by design; override here if using another project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: restrict sign-in to these emails (comma-separated). Empty = allow any Google account.
VITE_ALLOWED_EMAILS=
